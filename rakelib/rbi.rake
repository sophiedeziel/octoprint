# frozen_string_literal: true

require "fileutils"
require "tmpdir"

# Builds rbi/, the type signatures shipped with the gem for apps that use Sorbet.
# Tapioca merges every rbi/**/*.rbi file of a gem into the RBI it generates for it.
#
# - rbi/octoprint.rbi: the method signatures written as inline RBS comments, exported by `spoom srb sigs export`
# - rbi/octoprint/**/*.rbi: the Tapioca DSL RBIs from sorbet/rbi/dsl/octoprint/, which type the readers that
#   `auto_attr` defines at runtime. Spoom exports those readers without signatures.
#
# Tapioca drops all of a gem's RBIs when they conflict, so the build fails if the files can't be merged cleanly.
module RbiExport
  OUTPUT_DIR = "rbi"
  DSL_DIR = "sorbet/rbi/dsl"
  HEADER = <<~RBI
    # typed: true

    # DO NOT EDIT MANUALLY
    # This is an autogenerated file for types exported from the `octoprint` gem.
    # Please instead update this file by running `bundle exec rake rbi:export`.
  RBI

  module_function

  def build(destination)
    Dir.mktmpdir do |dir|
      # spoom wipes the output's directory, so it gets a fresh one of its own
      spoom_path = File.join(dir, "octoprint.rbi")
      system("bundle", "exec", "spoom", "srb", "sigs", "export", spoom_path, out: File::NULL, exception: true)
      signatures = File.read(spoom_path)

      write(destination, "octoprint.rbi", signatures)
      export_dsl_files(destination, superclasses(signatures))
    end

    check_conflicts!(destination)
  end

  def export_dsl_files(destination, superclasses)
    Dir["#{DSL_DIR}/octoprint/**/*.rbi"].each do |dsl_path|
      # The DSL RBIs omit superclasses. Without them, each class conflicts with its definition in octoprint.rbi.
      contents = File.read(dsl_path).gsub(/^class (\S+)$/) do
        superclass = superclasses[Regexp.last_match(1)]
        superclass ? "class #{Regexp.last_match(1)} < #{superclass}" : Regexp.last_match(0)
      end

      write(destination, dsl_path.delete_prefix("#{DSL_DIR}/"), contents)
    end
  end

  def superclasses(signatures)
    signatures.scan(/^class (?:::)?(\S+) < (\S+)$/).to_h
  end

  def write(destination, relative_path, contents)
    body = contents.sub(/\A(?:#.*\n|\n)*/, "")
    path = File.join(destination, relative_path)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, "#{HEADER}\n#{body}")
  end

  def check_conflicts!(destination)
    require "rbi"

    merger = RBI::Rewriters::Merge.new(keep: RBI::Rewriters::Merge::Keep::NONE)
    Dir["#{destination}/**/*.rbi"].each { |path| merger.merge(RBI::Parser.parse_file(path)) }
    conflicts = merger.tree.conflicts
    return if conflicts.empty?

    abort "The exported RBIs conflict, so Tapioca would ignore them:\n#{conflicts.map { |c| "  #{c}" }.join("\n")}"
  end
end

namespace :rbi do
  desc "Export the gem's type signatures to #{RbiExport::OUTPUT_DIR}/"
  task :export do
    Dir.mktmpdir do |dir|
      RbiExport.build(dir)
      FileUtils.rm_rf(RbiExport::OUTPUT_DIR)
      FileUtils.cp_r(dir, RbiExport::OUTPUT_DIR)
    end
    puts "Exported signatures to #{RbiExport::OUTPUT_DIR}/"
  end

  desc "Check that #{RbiExport::OUTPUT_DIR}/ is up to date"
  task :check do
    Dir.mktmpdir do |dir|
      RbiExport.build(dir)

      unless system("diff", "-ru", dir, RbiExport::OUTPUT_DIR)
        abort "#{RbiExport::OUTPUT_DIR}/ is not up to date. Run `bundle exec rake rbi:export` to update it."
      end

      puts "#{RbiExport::OUTPUT_DIR}/ is up to date"
    end
  end
end

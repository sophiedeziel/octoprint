# OctoPrint 1.11 server (the default for specs). OCTOPRINT_HOST / OCTOPRINT_API_KEY still work as a fallback.
OCTOPRINT_HOST_1_11="http://octoprint.local"
OCTOPRINT_API_KEY_1_11="change me"
# OctoPrint 2.0 server, used by specs tagged `octoprint: "2.0"`. Use a user or application key:
# 2.0 no longer generates a global API key.
OCTOPRINT_HOST_2_0="http://octoprint2.local"
OCTOPRINT_API_KEY_2_0="change me"
# Optional: a second, non-admin user, only needed to re-record the active login cassettes
OCTOPRINT_LOGIN_USER="vcruser"
OCTOPRINT_LOGIN_PASSWORD="change me"
